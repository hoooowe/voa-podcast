<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ episode.title }} - {{ site_title }}</title>
<style>
  :root {
    --bg: #fafafa;
    --card: #ffffff;
    --text: #1d1d1f;
    --text-muted: #6e6e73;
    --border: #e5e5e7;
    --accent: #0071e3;
    --accent-hover: #0077ed;
    --section-english: #f0f5ff;
    --section-chinese: #fff5f0;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #000000;
      --card: #1c1c1e;
      --text: #f5f5f7;
      --text-muted: #98989d;
      --border: #2c2c2e;
      --accent: #0a84ff;
      --accent-hover: #409cff;
      --section-english: #0c1a2e;
      --section-chinese: #2e1c0c;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue",
      "PingFang SC", "Microsoft YaHei", sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.6;
  }
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 32px 24px 80px;
  }
  .back {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-size: 15px;
    margin-bottom: 24px;
  }
  h1 {
    font-size: 30px;
    font-weight: 700;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .meta {
    color: var(--text-muted);
    font-size: 15px;
    margin: 0 0 32px;
  }
  .player {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px 24px;
    margin-bottom: 40px;
  }
  .player-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  audio { width: 100%; }
  section {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px 32px;
    margin-bottom: 24px;
  }
  h2 {
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .english h2 { color: var(--accent); }
  .chinese h2 { color: #c64a1e; }
  .english p {
    font-size: 18px;
    line-height: 1.8;
    margin: 0 0 16px;
  }
  .chinese p {
    font-size: 17px;
    line-height: 1.8;
    margin: 0 0 16px;
  }
  .source {
    font-size: 14px;
    color: var(--text-muted);
  }
  .source a {
    color: var(--accent);
    text-decoration: none;
    word-break: break-all;
  }
  footer {
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 48px;
  }
</style>
</head>
<body>
<div class="container">
  <a class="back" href="../index.html">← All Episodes</a>

  <h1>{{ episode.title }}</h1>
  <p class="meta">
    {{ episode.published_at_display }} · {{ episode.category or "General" }}
  </p>

  <div class="player">
    <p class="player-label">▶ VOA Original Audio</p>
    <audio controls preload="metadata" src="{{ episode.audio_url }}"></audio>
  </div>

  <section class="english">
    <h2>English</h2>
    {% for paragraph in episode.english_paragraphs %}
    <p>{{ paragraph }}</p>
    {% endfor %}
  </section>

  <section class="chinese">
    <h2>中文翻译</h2>
    {% for paragraph in episode.chinese_paragraphs %}
    <p>{{ paragraph }}</p>
    {% endfor %}
  </section>

  <section>
    <h2>Source</h2>
    <p class="source">
      Original VOA Article: <a href="{{ episode.source_url }}">{{ episode.source_url }}</a>
    </p>
  </section>

  <footer>For personal study use only · {{ episode.source }}</footer>
</div>
</body>
</html>
