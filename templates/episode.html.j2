<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ episode.title }} - {{ site_title }}</title>
<style>
  :root {
    --bg: #fafafa;
    --card: #ffffff;
    --text: #1d1d1f;
    --text-muted: #6e6e73;
    --border: #e5e5e7;
    --accent: #0071e3;
    --accent-hover: #0077ed;
    --section-english: #f0f5ff;
    --section-chinese: #fff5f0;
    --active-bg: #e8f1ff;
    --active-border: #0071e3;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #000000;
      --card: #1c1c1e;
      --text: #f5f5f7;
      --text-muted: #98989d;
      --border: #2c2c2e;
      --accent: #0a84ff;
      --accent-hover: #409cff;
      --section-english: #0c1a2e;
      --section-chinese: #2e1c0c;
      --active-bg: #0a2a4a;
      --active-border: #0a84ff;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue",
      "PingFang SC", "Microsoft YaHei", sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.6;
  }
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 32px 24px 80px;
  }
  .back {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-size: 15px;
    margin-bottom: 24px;
  }
  h1 {
    font-size: 30px;
    font-weight: 700;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .meta {
    color: var(--text-muted);
    font-size: 15px;
    margin: 0 0 32px;
  }
  .player {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px 24px;
    margin-bottom: 40px;
    position: sticky;
    top: 12px;
    z-index: 10;
  }
  .player-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  audio { width: 100%; }
  section {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px 32px;
    margin-bottom: 24px;
  }
  h2 {
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .english h2 { color: var(--accent); }
  .chinese h2 { color: #c64a1e; }
  .english p {
    font-size: 18px;
    line-height: 1.8;
    margin: 0 0 16px;
  }
  .chinese p {
    font-size: 17px;
    line-height: 1.8;
    margin: 0 0 16px;
  }
  .source {
    font-size: 14px;
    color: var(--text-muted);
  }
  .source a {
    color: var(--accent);
    text-decoration: none;
    word-break: break-all;
  }
  /* Interactive sentence list (click-to-seek) */
  .hint {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0 0 16px;
  }
  .sentence-list { list-style: none; padding: 0; margin: 0; }
  .sentence {
    border-left: 3px solid transparent;
    padding: 14px 16px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .sentence + .sentence { margin-top: 4px; }
  .sentence:hover { background: var(--active-bg); }
  .sentence.active {
    background: var(--active-bg);
    border-left-color: var(--active-border);
  }
  .sentence .en {
    font-size: 18px;
    line-height: 1.7;
    margin: 0 0 6px;
  }
  .sentence .zh {
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
    color: var(--text-muted);
  }
  .sentence.active .zh { color: var(--text); }
  .word {
    border-radius: 3px;
    transition: background 0.08s, color 0.08s;
  }
  .word.active {
    background: var(--active-border);
    color: #fff;
  }
  @media (prefers-color-scheme: dark) {
    .word.active { color: #fff; }
  }
  .time-tag {
    font-size: 12px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    margin-right: 8px;
    user-select: none;
  }
  footer {
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 48px;
  }
</style>
</head>
<body>
<div class="container">
  <a class="back" href="../index.html">← All Episodes</a>

  <h1>{{ episode.title }}</h1>
  <p class="meta">
    {{ episode.published_at_display }} · {{ episode.category or "General" }}
  </p>

  <div class="player">
    <p class="player-label">▶ VOA Original Audio</p>
    <audio id="player" controls preload="metadata" src="{{ episode.audio_url }}"></audio>
  </div>

  {% if episode.sentences %}
  <section class="bilingual">
    <h2>English &amp; 中文（点击句子跳转音频）</h2>
    <p class="hint">Click any sentence to jump to that point in the audio. The current sentence highlights as it plays.</p>
    <ul class="sentence-list">
      {% for s in episode.sentences %}
      <li class="sentence" data-start="{{ s.start }}">
        <p class="en"><span class="time-tag">{{ "%d:%02d" | format((s.start / 60) | int, (s.start % 60) | round | int) }}</span>{{ s.en }}</p>
        <p class="zh">{{ s.zh }}</p>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% else %}
  <section class="english">
    <h2>English</h2>
    {% for paragraph in episode.english_paragraphs %}
    <p>{{ paragraph }}</p>
    {% endfor %}
  </section>

  <section class="chinese">
    <h2>中文翻译</h2>
    {% for paragraph in episode.chinese_paragraphs %}
    <p>{{ paragraph }}</p>
    {% endfor %}
  </section>
  {% endif %}

  <section>
    <h2>Source</h2>
    <p class="source">
      Original VOA Article: <a href="{{ episode.source_url }}">{{ episode.source_url }}</a>
    </p>
  </section>

  <footer>For personal study use only · {{ episode.source }}</footer>
</div>
<script>
  (function () {
    var player = document.getElementById('player');
    if (!player) return;
    var sentences = Array.prototype.slice.call(
      document.querySelectorAll('.sentence')
    );
    if (!sentences.length) return;

    var starts = sentences.map(function (el) {
      return parseFloat(el.getAttribute('data-start')) || 0;
    });

    // Split each English line into per-word spans for word-level highlight.
    // Word timing is interpolated evenly within each sentence's time span
    // (sentence start -> next sentence start). VOA Special English is spoken
    // slowly and evenly, so this tracks the audio closely enough to read along.
    function escapeHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    var wordStarts = []; // wordStarts[i] = array of start times for sentence i's words
    sentences.forEach(function (el, i) {
      var enP = el.querySelector('.en');
      var timeTag = enP.querySelector('.time-tag');
      var timeTagHTML = timeTag ? timeTag.outerHTML : '';
      var text = enP.textContent;
      if (timeTag) text = text.replace(timeTag.textContent, '');
      var words = text.trim().split(/\s+/).filter(Boolean);
      enP.innerHTML = timeTagHTML + words.map(function (w) {
        return '<span class="word">' + escapeHtml(w) + '</span>';
      }).join(' ');
      var wordEls = Array.prototype.slice.call(enP.querySelectorAll('.word'));
      el._wordEls = wordEls;
      wordStarts.push([]);
    });

    function recomputeWordTimings() {
      var n = starts.length;
      for (var i = 0; i < n; i++) {
        var begin = starts[i];
        var end = (i + 1 < n) ? starts[i + 1] : (player.duration ? player.duration : begin + el_word_count(i) * 0.5);
        var wc = sentences[i]._wordEls.length;
        var step = wc > 1 ? (end - begin) / wc : (end - begin);
        var arr = [];
        for (var k = 0; k < wc; k++) {
          arr.push(begin + k * step);
        }
        wordStarts[i] = arr;
      }
    }
    function el_word_count(i) { return sentences[i]._wordEls.length; }

    var activeWord = null; // {s:i, w:k}
    function clearWords() {
      if (activeWord) {
        var prev = sentences[activeWord.s]._wordEls[activeWord.w];
        if (prev) prev.classList.remove('active');
        activeWord = null;
      }
    }

    function setActiveSentence(index) {
      sentences.forEach(function (el, i) {
        el.classList.toggle('active', i === index);
      });
      var active = sentences[index];
      if (active && active.scrollIntoView) {
        active.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    function currentSentenceIndex(t) {
      var idx = 0;
      for (var i = 0; i < starts.length; i++) {
        if (starts[i] <= t + 0.25) idx = i;
        else break;
      }
      return idx;
    }

    function currentWordIndex(si, t) {
      var arr = wordStarts[si] || [];
      var idx = -1;
      for (var k = 0; k < arr.length; k++) {
        if (arr[k] <= t + 0.15) idx = k;
        else break;
      }
      return idx;
    }

    function update(t) {
      var si = currentSentenceIndex(t);
      if (si !== lastSentence) {
        setActiveSentence(si);
        clearWords();
        lastSentence = si;
      }
      var wi = currentWordIndex(si, t);
      if (wi >= 0) {
        if (!activeWord || activeWord.s !== si || activeWord.w !== wi) {
          clearWords();
          var el = sentences[si]._wordEls[wi];
          if (el) el.classList.add('active');
          activeWord = { s: si, w: wi };
        }
      }
    }

    var lastSentence = -1;

    sentences.forEach(function (el, i) {
      el.addEventListener('click', function () {
        player.currentTime = starts[i];
        player.play().catch(function () {});
        setActiveSentence(i);
        clearWords();
        lastSentence = i;
      });
    });

    player.addEventListener('loadedmetadata', function () {
      recomputeWordTimings();
    });
    player.addEventListener('timeupdate', function () {
      if (!wordStarts[0] || !wordStarts[0].length) recomputeWordTimings();
      update(player.currentTime);
    });
  })();
</script>
</body>
</html>
