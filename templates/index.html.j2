<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site_title }}</title>
<style>
  :root {
    --bg: #fafafa;
    --card: #ffffff;
    --text: #1d1d1f;
    --text-muted: #6e6e73;
    --border: #e5e5e7;
    --accent: #0071e3;
    --accent-hover: #0077ed;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #000000;
      --card: #1c1c1e;
      --text: #f5f5f7;
      --text-muted: #98989d;
      --border: #2c2c2e;
      --accent: #0a84ff;
      --accent-hover: #409cff;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue",
      "PingFang SC", "Microsoft YaHei", sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.6;
  }
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }
  header {
    text-align: center;
    margin-bottom: 48px;
  }
  h1 {
    font-size: 34px;
    font-weight: 700;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }
  .subtitle {
    color: var(--text-muted);
    font-size: 17px;
    margin: 0 0 24px;
  }
  .subscribe {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 980px;
    font-size: 15px;
    font-weight: 500;
    transition: background 0.2s;
  }
  .subscribe:hover { background: var(--accent-hover); }
  .rss-url {
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-muted);
    word-break: break-all;
  }
  .rss-url code {
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    background: var(--card);
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
  }
  .episode-list { list-style: none; padding: 0; margin: 0; }
  .episode-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px 28px;
    margin-bottom: 20px;
    transition: transform 0.15s ease;
  }
  .episode-card:hover { transform: translateY(-2px); }
  .episode-number {
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 6px;
  }
  .episode-title {
    font-size: 22px;
    font-weight: 600;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .episode-title a { color: var(--text); text-decoration: none; }
  .episode-meta {
    color: var(--text-muted);
    font-size: 14px;
    margin: 0 0 16px;
  }
  .episode-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
  }
  .btn-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }
  .empty {
    text-align: center;
    color: var(--text-muted);
    padding: 60px 0;
  }
  footer {
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 48px;
  }
</style>
</head>
<body>
<div class="container">
  <header>
    <h1>{{ site_title }}</h1>
    <p class="subtitle">Personal English listening practice with VOA Learning English.</p>
    <a class="subscribe" href="podcasts://{{ feed_url }}">Subscribe with Apple Podcasts</a>
    <div class="rss-url">RSS: <code>{{ feed_url }}</code></div>
  </header>

  {% if episodes %}
  <ul class="episode-list">
    {% for ep in episodes %}
    <li class="episode-card">
      <p class="episode-number">#{{ "%03d" | format(ep.id) }}</p>
      <h2 class="episode-title"><a href="episodes/{{ ep.slug }}.html">{{ ep.title }}</a></h2>
      <p class="episode-meta">
        {{ ep.category or "General" }} · {{ ep.published_at_display }}
      </p>
      <div class="episode-actions">
        <a class="btn-link" href="{{ ep.audio_url }}">▶ Listen</a>
        <a class="btn-link" href="episodes/{{ ep.slug }}.html">Read English &amp; Chinese →</a>
      </div>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty">No episodes yet. Add one with <code>python scripts/add_episode.py "VOA_URL"</code></p>
  {% endif %}

  <footer>
    Source: VOA Learning English · For personal study use only
  </footer>
</div>
</body>
</html>
